/vendor/

/.env
/.env.local

# Credenciais que nao suportam variavel de ambiente no provedor de
# hospedagem (ver apps/igrejas/config/mercadopago.php) - criado direto no
# servidor, nunca pelo Git.
apps/*/config/*.local.php

/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/temp/*

# Uploads de cada aplicativo (ex.: logo da igreja) sao arquivos de runtime,
# nunca versionados.
apps/*/public/uploads/

node_modules/

.DS_Store
Thumbs.db

.idea/
.vscode/

composer.phar
