{
    "name": "kadosys/platform",
    "description": "Kadosys Platform - SaaS framework proprietario para multiplos aplicativos (Igrejas, CRM, Streamer, Escola, Condominio, ERP, RH).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Kadosys\\Core\\": "core/",
            "Kadosys\\Apps\\Igrejas\\": "apps/igrejas/",
            "Kadosys\\Apps\\Crm\\": "apps/crm/",
            "Kadosys\\Apps\\Streamer\\": "apps/streamer/",
            "Kadosys\\Apps\\Escola\\": "apps/escola/",
            "Kadosys\\Apps\\Condominio\\": "apps/condominio/",
            "Kadosys\\Apps\\Erp\\": "apps/erp/",
            "Kadosys\\Apps\\Rh\\": "apps/rh/"
        },
        "files": [
            "core/Helpers/helpers.php"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env') && file_exists('.env.example')) copy('.env.example', '.env');\""
        ]
    }
}
