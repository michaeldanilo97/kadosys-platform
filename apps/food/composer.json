{
    "name": "kadosys/food",
    "description": "KADOSYS Food - Plataforma de gestao para confeitarias, restaurantes e delivery",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Food\\Core\\": "src/Core/",
            "Food\\Controllers\\": "src/Controllers/",
            "Food\\Models\\": "src/Models/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
