{
    "name": "kadosys/superadmin",
    "description": "KADOSYS Super Admin - painel unico cruzando todos os produtos (Igrejas, Barbearias, futuros)",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Superadmin\\Core\\": "src/Core/",
            "Superadmin\\Controllers\\": "src/Controllers/",
            "Superadmin\\Models\\": "src/Models/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
